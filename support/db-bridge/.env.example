# TiDB Cloud Starter -> Connect -> Node.js. Keep TLS enabled.
DB_HOST=your-cluster.aws.tidbcloud.com
DB_PORT=4000
DB_NAME=bpstore_live
DB_USER=your-user
DB_PASS=your-password
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DB_BRIDGE_TOKEN=replace-with-a-new-random-token-at-least-32-characters
PORT=8787
